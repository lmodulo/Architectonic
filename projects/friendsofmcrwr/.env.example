# Copy to .env and adjust as needed
# docker compose reads .env automatically

WEB_PORT=3000
API_PORT=4000
MONGO_PORT=27017
MONGO_DB=appdb

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-random-64-char-hex-string

# Shared by the web and api services. The web server sends it with each API call, together with the
# visitor's address, so the API rate-limits every visitor separately; without it, all visitors share one
# limit (200 requests a minute, 10 login attempts a minute). At least 32 characters; generate it the same way as
# SESSION_SECRET. arch.js fills it in for new projects.
# Behind a reverse proxy, also set adapter-node's ADDRESS_HEADER (and XFF_DEPTH) on the web service, or
# every visitor arrives from the proxy's address.
INTERNAL_API_SECRET=

# Email / password reset
# Leave SMTP_HOST blank in dev — Ethereal test account is auto-provisioned and preview URLs logged to console
# Production examples: smtp.resend.com (Resend), smtp.postmarkapp.com (Postmark), smtp.mailgun.org (Mailgun)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Architectonic <noreply@example.com>
APP_URL=http://localhost:3000
APP_NAME=

# Demo data: set to true to load sample records for every installed module on boot
# (only into empty collections). Leave false for real projects.
SEED_DEMO_DATA=false

# Storage — Cloudflare R2 (S3-compatible, no egress fees)
# Leave STORAGE_PROVIDER=local in dev; set to s3 + fill in credentials for production
# R2 dashboard: Workers & Pages > R2 > your bucket > Settings
STORAGE_PROVIDER=local
AWS_BUCKET=uploads
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Public URL: enable "Public access" on the bucket, then use https://pub-xxxx.r2.dev
# or point a custom domain and use that instead
S3_PUBLIC_URL=

CALENDAR_REMINDER_INTERVAL_MS=1800000 # How often (ms) the reminder scheduler polls for upcoming events. Default: 30 minutes.
STRIPE_SECRET_KEY=sk_test_... # Stripe secret key (test key for dev)
STRIPE_WEBHOOK_SECRET=whsec_... # Stripe webhook signing secret
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_... # Stripe publishable key (browser-side)