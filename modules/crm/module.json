{
  "name": "crm",
  "description": "Contact and company relationship management with deal pipeline and activity tracking",
  "nav": [
    {
      "label": "Nexus",
      "href": "/crm",
      "icon": "Handshake",
      "permission": "crm_contacts.read"
    }
  ],
  "widgets": [
    {
      "component": "CrmDashboardWidget",
      "import": "$lib/components/crm/CrmDashboardWidget.svelte",
      "permission": "crm_contacts.read",
      "order": 20
    }
  ],
  "permissions": [
    {
      "resource": "crm_contacts",
      "actions": ["create", "read", "update", "delete"]
    },
    {
      "resource": "crm_companies",
      "actions": ["create", "read", "update", "delete"]
    },
    {
      "resource": "crm_deals",
      "actions": ["create", "read", "update", "delete"]
    },
    {
      "resource": "crm_activities",
      "actions": ["create", "read", "update", "delete"]
    }
  ],
  "roles": {
    "lead": {
      "crm_contacts":   ["create", "read", "update"],
      "crm_companies":  ["create", "read", "update"],
      "crm_deals":      ["create", "read", "update"],
      "crm_activities": ["create", "read", "update"]
    },
    "contributor": {
      "crm_contacts":   ["read"],
      "crm_companies":  ["read"],
      "crm_deals":      ["read"],
      "crm_activities": ["create", "read", "update"]
    }
  },
  "dependencies": {
    "frontend": {
      "libphonenumber-js": "^1.13.8"
    },
    "api": {
      "libphonenumber-js": "^1.13.8"
    }
  },
  "env": []
}
