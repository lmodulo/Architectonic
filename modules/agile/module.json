{
  "name": "agile",
  "description": "Project delivery tracking — milestones, sprints, jobs, tasks, time tracking, and reporting with optional calendar-events and CRM integration",
  "nav": [
    {
      "label": "Agile",
      "href": "/agile",
      "icon": "Milestone",
      "permission": "agile_milestones.read"
    },
    {
      "label": "Projects",
      "href": "/client-portal/projects",
      "icon": "FolderKanban",
      "permission": "agile_milestones.read",
      "matchPrefix": true,
      "customerOnly": true
    }
  ],
  "widgets": [
    {
      "component": "AgileDashboardWidget",
      "import": "$lib/components/agile/AgileDashboardWidget.svelte",
      "permission": "agile_milestones.read",
      "order": 30
    }
  ],
  "permissions": [
    {
      "resource": "agile_milestones",
      "actions": ["create", "read", "update", "delete"]
    },
    {
      "resource": "agile_sprints",
      "actions": ["create", "read", "update", "delete"]
    },
    {
      "resource": "agile_jobs",
      "actions": ["create", "read", "update", "delete"]
    },
    {
      "resource": "agile_tasks",
      "actions": ["create", "read", "update", "delete"]
    },
    {
      "resource": "agile_comments",
      "actions": ["create", "read", "update", "delete"]
    },
    {
      "resource": "agile_time_entries",
      "actions": ["create", "read", "update", "delete"]
    }
  ],
  "roles": {
    "lead": {
      "agile_milestones":   ["create", "read", "update"],
      "agile_sprints":      ["create", "read", "update"],
      "agile_jobs":         ["create", "read", "update"],
      "agile_tasks":        ["create", "read", "update", "delete"],
      "agile_comments":     ["create", "read", "update", "delete"],
      "agile_time_entries": ["create", "read", "update", "delete"]
    },
    "contributor": {
      "agile_milestones":   ["read"],
      "agile_sprints":      ["read"],
      "agile_jobs":         ["read"],
      "agile_tasks":        ["read", "update"],
      "agile_comments":     ["create", "read", "update", "delete"],
      "agile_time_entries": ["create", "read", "update", "delete"]
    },
    "customer": {
      "agile_milestones":   ["read"]
    }
  },
  "dependencies": {
    "frontend": {},
    "api": {}
  },
  "env": []
}
