{
  "name": "contracts",
  "description": "Contract drafting and e-signature collection with public signer links and signer/void tracking",
  "nav": [
    {
      "label": "Contracts",
      "href": "/contracts",
      "icon": "FileSignature",
      "permission": "contracts.read"
    }
  ],
  "widgets": [
    {
      "component": "ContractsDashboardWidget",
      "import": "$lib/components/contracts/ContractsDashboardWidget.svelte",
      "permission": "contracts.read",
      "order": 50
    }
  ],
  "permissions": [
    {
      "resource": "contracts",
      "actions": ["create", "read", "update", "delete"]
    },
    {
      "resource": "contract_templates",
      "actions": ["create", "read", "update", "delete"]
    }
  ],
  "roles": {
    "lead": {
      "contracts":          ["create", "read", "update"],
      "contract_templates": ["read"]
    },
    "contributor": {
      "contracts":          ["read"],
      "contract_templates": ["read"]
    },
    "customer": {
      "contracts":          ["read"]
    }
  },
  "dependencies": {
    "frontend": {},
    "api": {}
  },
  "env": []
}
