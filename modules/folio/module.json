{
  "name": "folio",
  "description": "Invoicing, estimates, recurring subscriptions/retainers, expense tracking, and Stripe payments",
  "nav": [
    {
      "label": "Folio",
      "href": "/folio",
      "icon": "Receipt",
      "permission": "finance_invoices.read"
    },
    {
      "label": "Invoices",
      "href": "/client-portal/invoices",
      "icon": "FileText",
      "permission": "finance_invoices.read",
      "matchPrefix": true,
      "customerOnly": true
    },
    {
      "label": "Estimates",
      "href": "/client-portal/estimates",
      "icon": "ClipboardList",
      "permission": "finance_estimates.read",
      "matchPrefix": true,
      "customerOnly": true
    }
  ],
  "widgets": [
    {
      "component": "FolioDashboardWidget",
      "import": "$lib/components/folio/FolioDashboardWidget.svelte",
      "permission": "finance_invoices.read",
      "order": 40
    }
  ],
  "permissions": [
    {
      "resource": "finance_invoices",
      "actions": ["create", "read", "update", "delete"]
    },
    {
      "resource": "finance_payments",
      "actions": ["create", "read", "update", "delete"]
    },
    {
      "resource": "finance_subscriptions",
      "actions": ["create", "read", "update", "delete"]
    },
    {
      "resource": "finance_estimates",
      "actions": ["create", "read", "update", "delete"]
    },
    {
      "resource": "finance_expenses",
      "actions": ["create", "read", "update", "delete"]
    },
    {
      "resource": "finance_reports",
      "actions": ["read"]
    }
  ],
  "roles": {
    "lead": {
      "finance_invoices":      ["read"],
      "finance_payments":      ["read"],
      "finance_subscriptions": ["read"],
      "finance_estimates":     ["read"],
      "finance_expenses":      ["read"],
      "finance_reports":       ["read"]
    },
    "contributor": {
      "finance_invoices":      ["read"],
      "finance_payments":      ["read"],
      "finance_estimates":     ["read"],
      "finance_expenses":      ["read"]
    },
    "customer": {
      "finance_invoices":      ["read"],
      "finance_payments":      ["create", "read"],
      "finance_subscriptions": ["read"],
      "finance_estimates":     ["read"]
    }
  },
  "dependencies": {
    "frontend": {
      "@stripe/stripe-js": "^9.4.0"
    },
    "api": {
      "stripe": "^22.1.1"
    }
  },
  "env": [
    {
      "key": "STRIPE_SECRET_KEY",
      "required": false,
      "default": "sk_test_...",
      "description": "Stripe secret key (test key for dev)"
    },
    {
      "key": "STRIPE_WEBHOOK_SECRET",
      "required": false,
      "default": "whsec_...",
      "description": "Stripe webhook signing secret"
    },
    {
      "key": "PUBLIC_STRIPE_PUBLISHABLE_KEY",
      "required": false,
      "default": "pk_test_...",
      "description": "Stripe publishable key (browser-side)"
    }
  ]
}
