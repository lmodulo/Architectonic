{
  "name": "vault",
  "description": "Document library — SOPs, policies, handbooks, and certificates organized by folder with versioning",
  "nav": [
    {
      "label": "Vault",
      "href": "/vault",
      "icon": "FolderLock",
      "permission": "vault_documents.read"
    }
  ],
  "permissions": [
    {
      "resource": "vault_documents",
      "actions": ["create", "read", "update", "delete"]
    },
    {
      "resource": "vault_folders",
      "actions": ["create", "read", "update", "delete"]
    }
  ],
  "dependencies": {
    "frontend": {},
    "api": {
      "@fastify/multipart": "^9.0.0",
      "@aws-sdk/client-s3": "^3.0.0"
    }
  },
  "env": [
    {
      "key": "STORAGE_PROVIDER",
      "required": false,
      "default": "local",
      "description": "File storage backend: 'local' (default) or 's3'"
    },
    {
      "key": "AWS_BUCKET",
      "required": false,
      "default": "",
      "description": "S3 bucket name (required when STORAGE_PROVIDER=s3)"
    },
    {
      "key": "AWS_REGION",
      "required": false,
      "default": "us-east-1",
      "description": "S3 region (required when STORAGE_PROVIDER=s3)"
    },
    {
      "key": "AWS_ACCESS_KEY_ID",
      "required": false,
      "default": "",
      "description": "S3 access key (required when STORAGE_PROVIDER=s3)"
    },
    {
      "key": "AWS_SECRET_ACCESS_KEY",
      "required": false,
      "default": "",
      "description": "S3 secret key (required when STORAGE_PROVIDER=s3)"
    }
  ]
}
